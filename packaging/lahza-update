#!/usr/bin/python3
"""Check and install stable Lahza Debian releases using the system package manager."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request


REPOSITORY = "https://github.com/FarhanAliRaza/Lahza"
LATEST = "https://api.github.com/repos/FarhanAliRaza/Lahza/releases/latest"


def output(*args):
    return subprocess.check_output(args, text=True).strip()


def fetch(url):
    request = urllib.request.Request(url, headers={"User-Agent": "lahza-update"})
    return urllib.request.urlopen(request, timeout=30)


def release_assets(release, architecture):
    tag = release.get("tag_name", "")
    if release.get("draft") or release.get("prerelease") or not re.fullmatch(r"v\d+\.\d+\.\d+", tag):
        raise ValueError("Latest release is not a supported stable version.")
    version = tag[1:]
    name = f"lahza_{version}_{architecture}.deb"
    assets = {asset["name"]: asset["browser_download_url"] for asset in release["assets"]}
    for filename in (name, "SHA256SUMS"):
        expected = f"{REPOSITORY}/releases/download/{tag}/{filename}"
        if assets.get(filename) != expected:
            raise ValueError(f"Release is missing a valid {filename} asset.")
    return version, name, assets


def expected_checksum(manifest, name):
    matches = []
    for line in manifest.splitlines():
        parts = line.split(maxsplit=1)
        if len(parts) == 2 and parts[1].lstrip("*") == name:
            matches.append(parts[0])
    if len(matches) != 1 or not re.fullmatch(r"[0-9a-fA-F]{64}", matches[0]):
        raise ValueError(f"Missing or ambiguous SHA256 checksum for {name}.")
    return matches[0].lower()


def warn_about_local_install():
    executable = shutil.which("lahza")
    if executable and Path(executable).resolve() != Path("/usr/bin/lahza").resolve():
        print(f"Notice: your shell launches {executable}; Debian updates /usr/bin/lahza.")
    desktop = Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) / "applications/com.lahza.Lahza.desktop"
    if desktop.exists():
        print(f"Notice: {desktop} overrides the Debian package's app launcher.")


def install_release(version, name, assets, architecture):
    with fetch(assets["SHA256SUMS"]) as response:
        checksum = expected_checksum(response.read(1024 * 1024).decode("utf-8"), name)
    with tempfile.TemporaryDirectory(prefix="lahza-update-") as directory:
        package = Path(directory) / name
        digest = hashlib.sha256()
        with fetch(assets[name]) as response, package.open("wb") as destination:
            while chunk := response.read(1024 * 1024):
                digest.update(chunk)
                destination.write(chunk)
        if digest.hexdigest() != checksum:
            raise ValueError("Downloaded package failed SHA256 verification; nothing installed.")
        for field, expected in (("Package", "lahza"), ("Version", version), ("Architecture", architecture)):
            if output("dpkg-deb", "--field", str(package), field) != expected:
                raise ValueError(f"Downloaded package has an unexpected {field}; nothing installed.")
        # Allow APT's unprivileged _apt user to read this public release archive.
        os.chmod(directory, 0o755)
        package.chmod(0o644)
        command = ["apt", "install", str(package)]
        if os.geteuid() != 0:
            command.insert(0, "sudo")
        subprocess.run(command, check=True)
    print("Update installed. Save your work, fully quit Lahza, then reopen /usr/bin/lahza.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--check", action="store_true", help="check for an update (default)")
    modes.add_argument("--install", action="store_true", help="download, verify, and install using APT")
    args = parser.parse_args()
    try:
        architecture = output("dpkg", "--print-architecture")
        if architecture != "amd64":
            raise ValueError(f"No Debian release is available for {architecture}.")
        try:
            status = output("dpkg-query", "-W", "-f=${Status}\n${Version}", "lahza").splitlines()
        except subprocess.CalledProcessError:
            status = []
        if len(status) != 2 or status[0] != "install ok installed":
            raise ValueError("Install Lahza's .deb package first. This updater only manages Debian installations.")
        installed = status[1]
        warn_about_local_install()
        with fetch(LATEST) as response:
            release = json.load(response)
        version, name, assets = release_assets(release, architecture)
        comparison = subprocess.run(["dpkg", "--compare-versions", version, "gt", installed])
        if comparison.returncode == 1:
            print(f"Lahza {installed} is up to date (latest stable: {version}).")
            return 0
        comparison.check_returncode()
        print(f"Lahza {version} is available (installed: {installed}).", flush=True)
        if args.install:
            install_release(version, name, assets, architecture)
        else:
            print("Run lahza-update --install to update.")
        return 0
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f"Update failed: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
